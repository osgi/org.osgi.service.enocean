                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt"
                                          text-align="left">
                              <fo:block>190</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt"
                                          text-align="left">
                              <fo:block>209</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
