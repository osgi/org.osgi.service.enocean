                     hyphenation-remain-character-count="2">
      <fo:static-content flow-name="xsl-region-before-first">
         <fo:block font-family="ProductusBook,ArialUnicodeMS"
                   margin-left="0pt"
                   font-size="10pt"
                   line-height="10pt"
                   font-weight="normal"
                   hyphenate="false"
                   letter-spacing="0.03em">
            <fo:table xmlns:d="http://docbook.org/ns/docbook"
